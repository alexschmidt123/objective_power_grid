    <P Name="Position">[260, 70, 380, 110]</P>
    <P Name="ZOrder">289</P>
    <P Name="Expr">0.5*u(1)*(1-cos(2*pi*u(2)/u(3)))*(u(2)&lt;=u(3))</P>
  </Block>
