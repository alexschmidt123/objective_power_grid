# ============================================================================
# Project-Specific: Data & Models (Large Files)
# ============================================================================
# Trained models (PyTorch)
*.pth
*.pt
*.h5
*.pkl
*.pickle

# Datasets
*.npy
*.npz
*.hdf5
*.mat

# Generated train/test JSON (shared across experiments with same config + T)
data/
models/
# results/ removed: all outputs go under experiments/
Experiment/

# Run artifacts (never sync experiment outputs)
experiments/

# Allow example configs and small test files (optional)
# !configs/**
# !data/README.md

# ============================================================================
# Project-Specific: Results & Logs
# ============================================================================
# Result files
*.txt
!requirements.txt
!README.txt

# Plots and figures (track only documents/images/*.png for design_github.md)
*.png
*.jpg
*.jpeg
*.svg
!documents/images/*.png
# Do not track readme in documents/images
documents/images/README*
documents/images/readme_design_github*
documents/image/

# Logs (never a top-level logs/ folder; per-run logs live under experiments/*/logs/)
*.log
/logs/

# Tensorboard
runs/
tensorboard/

